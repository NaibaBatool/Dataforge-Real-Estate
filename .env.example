# ==========================================================
# DataForge Estates — Environment Configuration Template
# Copy this file to .env.local for Next.js or .env for Flask
# ==========================================================

# Administrator Portal Authentication
ADMIN_EMAIL=admin@dataforge.com
ADMIN_PASSWORD=1234dataforge
ADMIN_AUTH_SECRET=dataforge-estates-secret-key-2026-auth

# Frontend (Next.js)
# Optional: Set this if you wish Next.js client to proxy requests directly to the Flask backend
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Backend (Python Flask)
PORT=5000
FLASK_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Supabase (PostgreSQL) — Required only when persisting to external database
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# n8n Automation Workflow — Optional webhook for CRM/lead notifications
# N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/lead-created
# N8N_WEBHOOK_SECRET=your-secure-webhook-token
